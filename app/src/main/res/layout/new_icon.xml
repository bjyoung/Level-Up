<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/NewIcon"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/NewIconLabel"
        style="@style/Text"
        android:text="@string/new_icon_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/title_vertical_bias" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/IconPreviewButton"
        style="@style/QuestIcon"
        android:contentDescription="@string/icon_input_content_description"
        app:fabCustomSize="80dp"
        app:maxImageSize="48dp"
        app:layout_constraintBottom_toTopOf="@+id/CancelButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/NewIconLabel"
        app:layout_constraintVertical_bias="0.2"
        app:srcCompat="@drawable/question_mark_icon_large" />

    <TextView
        android:id="@+id/IconNameLabel"
        style="@style/Label"
        android:text="@string/name_label"
        app:layout_constraintBottom_toTopOf="@+id/CancelButton"
        app:layout_constraintStart_toStartOf="@+id/IconNameInput"
        app:layout_constraintTop_toBottomOf="@+id/IconPreviewButton"
        app:layout_constraintVertical_bias="0.3" />

    <EditText
        android:id="@+id/IconNameInput"
        style="@style/TextInput"
        android:layout_width="325dp"
        android:layout_marginTop="8dp"
        android:autofillHints="item_name"
        android:ems="10"
        android:hint="@string/name_hint"
        android:inputType="textPersonName"
        android:maxLength="@integer/max_icon_name_length"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/IconNameLabel" />

    <Button
        android:id="@+id/CancelButton"
        style="@style/CancelButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ConfirmButton"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/action_button_vertical_bias" />

    <Button
        android:id="@+id/ConfirmButton"
        style="@style/SaveButton"
        app:layout_constraintBottom_toBottomOf="@+id/CancelButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/CancelButton"
        app:layout_constraintTop_toTopOf="@+id/CancelButton" />

</androidx.constraintlayout.widget.ConstraintLayout>